GEMINI_API_KEY=your_gemini_api_key_here
MONGODB_URI=mongodb://localhost:27017/foodlens
PORT=3001
NODE_ENV=development

# Nutrition lookup chain (optional — improves accuracy, free tiers available)
# Nutritionix: https://developer.nutritionix.com/ (free 500 req/day, best Indian food coverage)
NUTRITIONIX_APP_ID=your_nutritionix_app_id
NUTRITIONIX_APP_KEY=your_nutritionix_app_key

# USDA FoodData Central: https://fdc.nal.usda.gov/api-guide.html (free, optional)
USDA_API_KEY=DEMO_KEY

# Expo Push Notifications (optional — leave empty for unauthenticated Expo push, or add token for enhanced push)
# Get from: https://expo.dev/accounts/[your-account]/settings/access-tokens
EXPO_ACCESS_TOKEN=
